{
  "name": "touching-grass",
  "displayName": "touching grass",
  "description": "Learn to build AI agents by typing the code yourself, one Step at a time, with visible Checks.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "touching-grass",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "touchingGrass.openTrack",
        "title": "Open Track",
        "category": "Touching Grass",
        "icon": "$(library)"
      },
      {
        "command": "touchingGrass.validateTrack",
        "title": "Validate Track",
        "category": "Touching Grass"
      },
      {
        "command": "touchingGrass.chooseWorkspace",
        "title": "Choose Agent Workspace",
        "category": "Touching Grass"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "touchingGrass",
          "title": "Touching Grass",
          "icon": "media/grass.svg"
        }
      ]
    },
    "views": {
      "touchingGrass": [
        {
          "id": "touchingGrass.track",
          "name": "Track"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "touchingGrass.track",
        "contents": "No Track open.\n[Open Track](command:touchingGrass.openTrack)"
      }
    ],
    "configuration": {
      "title": "touching grass",
      "properties": {
        "touchingGrass.tutor.open": {
          "type": "string",
          "enum": [
            "auto",
            "extension",
            "terminal"
          ],
          "enumDescriptions": [
            "Use the Claude Code extension's chat if it is installed, otherwise a terminal.",
            "Use the Claude Code extension's chat. Show an error if it is not installed.",
            "Always run Claude Code in a terminal called \"Claude tutor\"."
          ],
          "default": "auto",
          "description": "How \"Ask Claude about this Step\" opens the Tutor."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "touchingGrass.openTrack",
          "when": "view == touchingGrass.track",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && vscode-test",
    "validate-track": "node dist/validate.js",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies -o touching-grass.vsix"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^5.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhongxuank/touching-grass"
  },
  "keywords": [
    "ai-agents",
    "learning",
    "education",
    "llm",
    "rag",
    "python",
    "tutorial"
  ],
  "homepage": "https://github.com/zhongxuank/touching-grass#readme",
  "bugs": {
    "url": "https://github.com/zhongxuank/touching-grass/issues"
  }
}
