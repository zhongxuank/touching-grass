{
  "name": "touching-grass",
  "displayName": "touching grass",
  "description": "Walks a Learner through building real things by hand, one Step at a time.",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "publisher": "touching-grass",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "touchingGrass.openTrack",
        "title": "Open Track",
        "category": "Touching Grass"
      },
      {
        "command": "touchingGrass.validateTrack",
        "title": "Validate Track",
        "category": "Touching Grass"
      },
      {
        "command": "touchingGrass.chooseWorkspace",
        "title": "Choose Agent Workspace",
        "category": "Touching Grass"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "touchingGrass",
          "title": "Touching Grass",
          "icon": "media/grass.svg"
        }
      ]
    },
    "views": {
      "touchingGrass": [
        {
          "id": "touchingGrass.track",
          "name": "Track"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "touchingGrass.track",
        "contents": "No Track open.\n[Open Track](command:touchingGrass.openTrack)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && vscode-test",
    "validate-track": "node dist/validate.js",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license -o touching-grass.vsix"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^5.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhongxuank/touching-grass"
  }
}
