{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "mocha"]
  },
  "include": ["src", "test", "esbuild.mjs", "vitest.config.ts"],
  "exclude": ["test/fixtures"]
}
